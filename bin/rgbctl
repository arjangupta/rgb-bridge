#!/usr/bin/python3
"""Unprivileged client for the local RGB broker."""

import json
import re
import socket
import sys
import time

SOCKET_PATH = "/run/rgb-bridge/control.sock"


def usage() -> None:
    print(
        "Usage: rgbctl cycle | static RRGGBB | off | "
        "cooler-test HEADER RRGGBB | list | status",
        file=sys.stderr,
    )


def request(payload: dict) -> dict:
    last_error: OSError | None = None
    for _ in range(50):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.connect(SOCKET_PATH)
                client.sendall((json.dumps(payload) + "\n").encode("utf-8"))
                client.shutdown(socket.SHUT_WR)
                response = bytearray()
                while True:
                    chunk = client.recv(4096)
                    if not chunk:
                        break
                    response.extend(chunk)
            return json.loads(response.decode("utf-8"))
        except (FileNotFoundError, ConnectionRefusedError) as exc:
            last_error = exc
            time.sleep(0.1)
    raise RuntimeError(f"RGB bridge is unavailable: {last_error}")


def main() -> int:
    args = sys.argv[1:]
    if args == ["cycle"]:
        payload = {"action": "cycle"}
    elif len(args) == 2 and args[0] == "static" and re.fullmatch(r"[0-9A-Fa-f]{6}", args[1]):
        payload = {"action": "static", "color": args[1].upper()}
    elif (
        len(args) == 3
        and args[0] == "cooler-test"
        and args[1] in {"1", "2"}
        and re.fullmatch(r"[0-9A-Fa-f]{6}", args[2])
    ):
        payload = {
            "action": "cooler-test",
            "header": int(args[1]),
            "color": args[2].upper(),
        }
    elif args in (["off"], ["list"], ["status"]):
        payload = {"action": args[0]}
    else:
        usage()
        return 2

    try:
        response = request(payload)
    except (RuntimeError, OSError, json.JSONDecodeError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    output = response.get("output")
    if output:
        print(output, end="" if output.endswith("\n") else "\n")
    if payload["action"] == "status":
        print(json.dumps(response, indent=2, sort_keys=True))
    if not response.get("ok"):
        print(response.get("error", "RGB request failed"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
